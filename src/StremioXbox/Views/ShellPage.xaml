<Page
    x:Class="StremioXbox.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <NavigationView x:Name="Nav"
                    Margin="{StaticResource TvSafeMargin}"
                    PaneDisplayMode="Top"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    SelectionChanged="Nav_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Board" Tag="board" Icon="Home" />
            <NavigationViewItem Content="Search" Tag="search" Icon="Find" />
            <NavigationViewItem Content="Library" Tag="library" Icon="Library" />
            <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting" />
        </NavigationView.MenuItems>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
