<Page
    x:Class="StremioXbox.Views.BoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    KeyDown="BoardPage_KeyDown">

    <Page.Resources>
        <DataTemplate x:Key="LargePosterTemplate">
            <Grid Width="330" Height="500" Margin="8,8,30,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="462" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="PosterFocusRing"
                    Width="312"
                    Height="462"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    CornerRadius="10">

                    <Border
                        Width="300"
                        Height="450"
                        Background="#2A2840"
                        CornerRadius="7">

                        <Image
                            x:Name="PosterImage"
                            Width="300"
                            Height="450"
                            Source="{Binding Poster}"
                            Stretch="UniformToFill" />
                    </Border>
                </Border>

                <TextBlock
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    FontSize="18"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="2"
                    TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>

        <Style
            x:Key="PosterItemContainerStyle"
            TargetType="ListViewItem">

            <Setter Property="Width" Value="330" />
            <Setter Property="Height" Value="500" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="330" />
            <Setter Property="MinHeight" Value="500" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualPrimaryBrush" Value="Transparent" />
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
    </Page.Resources>

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="CatalogPosition"
            HorizontalAlignment="Right"
            Margin="0,0,12,0"
            FontSize="16"
            Foreground="{StaticResource MutedTextBrush}" />

        <Grid
            Grid.Row="2"
            RowSpacing="18">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="TopCatalogTitle"
                    FontSize="26"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" />

                <ListView
                    x:Name="TopCatalogList"
                    Grid.Row="1"
                    Padding="12,4,30,12"
                    Tag="0"
                    XYFocusKeyboardNavigation="Enabled"
                    ItemsPanel="{StaticResource HorizontalPanel}"
                    ItemTemplate="{StaticResource LargePosterTemplate}"
                    ItemContainerStyle="{StaticResource PosterItemContainerStyle}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="Poster_ItemClick"
                    ContainerContentChanging="CatalogList_ContainerContentChanging"
                    KeyDown="CatalogList_KeyDown"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Hidden" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="BottomCatalogTitle"
                    FontSize="26"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" />

                <ListView
                    x:Name="BottomCatalogList"
                    Grid.Row="1"
                    Padding="12,4,30,12"
                    Tag="1"
                    XYFocusKeyboardNavigation="Enabled"
                    ItemsPanel="{StaticResource HorizontalPanel}"
                    ItemTemplate="{StaticResource LargePosterTemplate}"
                    ItemContainerStyle="{StaticResource PosterItemContainerStyle}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="Poster_ItemClick"
                    ContainerContentChanging="CatalogList_ContainerContentChanging"
                    KeyDown="CatalogList_KeyDown"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Hidden" />
            </Grid>
        </Grid>

        <ProgressRing
            x:Name="Loading"
            Width="64"
            Height="64"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="True" />

        <TextBlock
            x:Name="Message"
            MaxWidth="700"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </Grid>
</Page>