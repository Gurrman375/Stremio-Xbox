<Page
    x:Class="StremioXbox.Views.BoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Rows" XYFocusKeyboardNavigation="Enabled">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeaderStyle}" />
                            <ListView ItemsSource="{Binding Items}"
                                      ItemTemplate="{StaticResource PosterTemplate}"
                                      ItemsPanel="{StaticResource HorizontalPanel}"
                                      ScrollViewer.HorizontalScrollMode="Enabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="Poster_ItemClick" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ProgressRing x:Name="Loading" IsActive="True" Width="64" Height="64" />
        <TextBlock x:Name="Message" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="700" TextAlignment="Center" />
    </Grid>
</Page>
