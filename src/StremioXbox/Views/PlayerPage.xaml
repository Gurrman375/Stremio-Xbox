<Page
    x:Class="StremioXbox.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    Background="Black">

    <Grid>
        <vlc:VideoView x:Name="Video" Initialized="Video_Initialized" />

        <ProgressRing x:Name="Buffering" IsActive="True" Width="72" Height="72" />

        <Grid x:Name="Overlay" VerticalAlignment="Bottom" Padding="64,24,64,40">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#D0000000" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

            <Grid Grid.Row="1" Margin="0,12,0,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionText" Text="0:00" VerticalAlignment="Center" />
                <ProgressBar x:Name="Progress" Grid.Column="1" Maximum="1" Height="6" VerticalAlignment="Center"
                             Foreground="{StaticResource AccentPurpleBrush}" />
                <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,16,0,0"
                        XYFocusKeyboardNavigation="Enabled">
                <Button x:Name="BackButton" Click="Rewind_Click" ToolTipService.ToolTip="Back 10s">
                    <SymbolIcon Symbol="Previous" />
                </Button>
                <Button x:Name="PlayPauseButton" Click="PlayPause_Click">
                    <SymbolIcon x:Name="PlayPauseIcon" Symbol="Pause" />
                </Button>
                <Button x:Name="ForwardButton" Click="Forward_Click" ToolTipService.ToolTip="Forward 30s">
                    <SymbolIcon Symbol="Next" />
                </Button>
                <Button x:Name="AudioButton" ToolTipService.ToolTip="Audio">
                    <SymbolIcon Symbol="Volume" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="AudioMenu" Opening="AudioMenu_Opening" />
                    </Button.Flyout>
                </Button>
                <Button x:Name="SubtitleButton" ToolTipService.ToolTip="Subtitles">
                    <SymbolIcon Symbol="ClosedCaption" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="SubtitleMenu" Opening="SubtitleMenu_Opening" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ErrorText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="22" TextWrapping="Wrap" MaxWidth="800" TextAlignment="Center" />
    </Grid>
</Page>
