<Page
    x:Class="StremioXbox.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="8">
        <GridView x:Name="Items" SelectionMode="None" IsItemClickEnabled="True"
                  ItemTemplate="{StaticResource PosterTemplate}" ItemClick="Items_ItemClick" />
        <ProgressRing x:Name="Loading" IsActive="True" Width="64" Height="64" />
        <TextBlock x:Name="Message" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" MaxWidth="700" TextAlignment="Center" />
    </Grid>
</Page>
