<Application
    x:Class="StremioXbox.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    RequiresPointerMode="WhenRequested">

    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#141322" />
            <SolidColorBrush x:Key="AccentPurpleBrush" Color="#7B5BF5" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#A9A7BF" />

            <!-- TV-safe margin: Xbox overscan can crop up to ~5% at each edge. -->
            <Thickness x:Key="TvSafeMargin">48,27,48,27</Thickness>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,16,0,8" />
            </Style>

            <DataTemplate x:Key="PosterTemplate">
                <Grid Width="150" Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="225" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="#2A2840" CornerRadius="6">
                        <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                               FontSize="14" Margin="2,6,2,0" />
                </Grid>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="HorizontalPanel">
                <ItemsStackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
